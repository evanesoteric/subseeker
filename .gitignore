# ---------------------------------------------------------------------------
# Zig build artifacts
# ---------------------------------------------------------------------------
# Local build cache (regenerated by `zig build`; never commit it).
.zig-cache/
# Older Zig versions used this name for the cache.
zig-cache/
# Compiled output tree, including zig-out/bin/subseeker.
zig-out/

# Release artifacts (published as GitHub release assets, not committed)
subseeker-v*
SHA256SUMS

# ---------------------------------------------------------------------------
# Local run artifacts you probably don't want in git
# ---------------------------------------------------------------------------
# Scan results written with --outfile (adjust/remove if you DO want to commit
# sample output).
*.out
found.txt
found.json
results.txt
results.json

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
*.swp
*~
.DS_Store
.idea/
.vscode/
